{
    "extends": ["eslint:recommended", "prettier"],
    "parserOptions": {
        "ecmaVersion": 2021,
        "sourceType": "module"
    },
    "env": {
        "es6": true,
        "browser": true,
        "node": true
    },
    "ignorePatterns": ["**/build/*"],
    "rules": {
        "semi": 1,
        "no-console": 1,
        "no-var": 1,
        "camelcase": 1
    }
}
