{
  "name": "wiseframework",
  "version": "1.0.0",
  "description": "*by Anastiuk*",
  "main": "index.js",
  "scripts": {
    "start": "node index",
    "nodemon": "nodemon start",
    "webpack-dev": "webpack --mode development --watch",
    "webpack-build": "webpack --mode production",
    "dev": "npm-run-all --parallel webpack-dev nodemon migrate-latest",
    "migrate-latest": "knex migrate:latest --knexfile database/knexfile.js --esm",
    "migrate-up": "knex migrate:up --knexfile database/knexfile.js --esm",
    "migrate-down": "knex migrate:down --knexfile database/knexfile.js --esm",
    "migrate-rollback": "knex migrate:rollback --knexfile database/knexfile.js --esm",
    "prepare": "husky install",
    "lint-fix": "eslint index.js ./database ./client",
    "test": "mocha test/**/*.test.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@babel/polyfill": "^7.12.1",
    "@emotion/react": "^11.7.0",
    "@emotion/styled": "^11.6.0",
    "@fontsource/roboto": "^4.5.1",
    "@material-ui/core": "^4.12.3",
    "@material-ui/icons": "^4.11.2",
    "@mui/icons-material": "^5.2.0",
    "@mui/styles": "^5.2.1",
    "babel-plugin-direct-import": "^1.0.0",
    "babel-plugin-import": "^1.13.3",
    "babel-preset-es2015": "^6.24.1",
    "config": "^3.3.6",
    "cookie-parser": "^1.4.5",
    "express": "^4.17.1",
    "express-validator": "^6.13.0",
    "knex": "^0.95.11",
    "mysql2": "^2.3.0",
    "passport": "^0.5.0",
    "passport-jwt": "^4.0.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "virtual-dom": "^2.1.1"
  },
  "type": "module",
  "devDependencies": {
    "@babel/core": "^7.15.5",
    "@babel/eslint-parser": "^7.16.3",
    "@babel/plugin-syntax-jsx": "^7.16.0",
    "@babel/preset-env": "^7.15.6",
    "@babel/preset-react": "^7.16.0",
    "@mui/material": "^5.2.1",
    "axios": "^0.24.0",
    "babel-loader": "^8.2.2",
    "babel-plugin-transform-imports": "^2.0.0",
    "bcrypt": "^5.0.1",
    "body-parser": "^1.19.0",
    "chai": "^4.3.4",
    "clean-webpack-plugin": "^4.0.0",
    "css-loader": "^6.3.0",
    "dotenv": "^10.0.0",
    "eslint": "^7.32.0",
    "eslint-config-airbnb": "^18.2.1",
    "eslint-config-airbnb-base": "^14.2.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.27.1",
    "eslint-plugin-react-hooks": "^4.2.0",
    "html-webpack-plugin": "^5.5.0",
    "husky": "^7.0.2",
    "jsonwebtoken": "^8.5.1",
    "lint-staged": "^11.2.3",
    "mocha": "^9.1.3",
    "nodemon": "^2.0.12",
    "npm-run-all": "^4.1.5",
    "prettier": "2.4.1",
    "react-router-dom": "^6.0.2",
