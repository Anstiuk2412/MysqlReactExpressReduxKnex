{
  "name": "wiseframework",
  "version": "1.0.0",
  "description": "*by Anastiuk*",
  "main": "index.js",
  "scripts": {
    "start": "node index",
    "nodemon": "nodemon start",
    "webpack-dev": "webpack --mode development --watch",
    "webpack-build": "webpack --mode production",
    "dev": "npm run nodemon & knex migrate:latest --knexfile database/knexfile.js --esm",
    "migrate-latest": "knex migrate:latest --knexfile database/knexfile.js --esm",
    "migrate-up": "knex migrate:up --knexfile database/knexfile.js --esm",
    "migrate-down": "knex migrate:down --knexfile database/knexfile.js --esm",
    "migrate-rollback": "knex migrate:rollback --knexfile database/knexfile.js --esm",
    "prepare": "husky install",
    "lint-fix": "eslint index.js ./database ./client"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@babel/polyfill": "^7.12.1",
    "babel-preset-es2015": "^6.24.1",
    "config": "^3.3.6",
    "express": "^4.17.1",
    "knex": "^0.95.11",
    "mysql2": "^2.3.0",
    "passport-jwt": "^4.0.0",
    "virtual-dom": "^2.1.1"
  },
  "type": "module",
  "devDependencies": {
    "@babel/core": "^7.15.5",
    "@babel/preset-env": "^7.15.6",
    "babel-loader": "^8.2.2",
    "bcrypt": "^5.0.1",
    "body-parser": "^1.19.0",
    "clean-webpack-plugin": "^4.0.0",
    "css-loader": "^6.3.0",
    "dotenv": "^10.0.0",
    "eslint": "^7.32.0",
    "eslint-config-airbnb": "^18.2.1",
    "eslint-config-airbnb-base": "^14.2.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.26.1",
    "eslint-plugin-react-hooks": "^4.2.0",
    "express-validator": "^6.13.0",
    "husky": "^7.0.2",
    "lint-staged": "^11.2.3",
    "nodemon": "^2.0.12",
    "prettier": "2.4.1",
    "style-loader": "^3.3.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "npm run lint-fix",
      "git add"
    ]
  }
}
